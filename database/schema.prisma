model BlogPost {
 id String @id @default(cuid())
 title String @db.VarChar(255)
 slug String
 locale String @default("en")
 excerpt String @db.Text
 content String @db.LongText
 image String @default("") @db.VarChar(2048)
 status String @default("draft")
 featured Boolean @default(false)
 sortOrder Int @default(0)
 data Json
 seoTitle String @default("") @db.VarChar(255)
 seoDescription String @db.Text
 ogImage String @default("") @db.VarChar(2048)
 canonical String @default("") @db.VarChar(2048)
 keywords String @db.Text
 publishedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 authorId String?
 author User? @relation(fields:[authorId],references:[id],onDelete:SetNull)
 categoryId String?
 category BlogCategory? @relation(fields:[categoryId],references:[id],onDelete:SetNull)
 tags BlogTag[] @relation("PostTags")
 @@unique([slug,locale])
 @@index([status,locale,sortOrder])
 @@map("blog_posts")
}

model PortfolioImage {
 id String @id @default(cuid())
 portfolioId String
 portfolio Portfolio @relation(fields:[portfolioId],references:[id],onDelete:Cascade)
 url String @db.Text
 alt String @db.Text
 sortOrder Int @default(0)
 @@map("portfolio_images")
}
